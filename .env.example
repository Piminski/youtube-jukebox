# Copy to `.env` and fill in. See DEPLOY.md.

# Supabase project URL + anon/public key (Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# YouTube Data API v3 key (restrict by HTTP referrer in Google Cloud Console)
VITE_YOUTUBE_API_KEY=

# Optional fallback if Settings → Event title is empty
VITE_EVENT_NAME=
